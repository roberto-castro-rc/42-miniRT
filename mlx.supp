# Valgrind suppression file for MLX42 / GLFW / OpenGL
# Usage: valgrind --suppressions=mlx.supp ./miniRT scene.rt

# ---------- Dynamic Linker (ld-linux / glibc) ----------
{
   ld_linux_invalid_read_strncmp
   Memcheck:Addr8
   fun:strncmp
   fun:is_dst
   ...
}
{
   ld_linux_invalid_read_dst_substitute
   Memcheck:Addr8
   fun:strncmp
   fun:is_dst
   fun:_dl_dst_substitute
   ...
}
{
   ld_linux_invalid_read_dst_count
   Memcheck:Addr8
   fun:strncmp
   fun:is_dst
   fun:_dl_dst_count
   ...
}
{
   ld_linux_decompose_rpath
   Memcheck:Leak
   match-leak-kinds: reachable,definite,indirect,possible
   ...
   fun:decompose_rpath
}
{
   ld_linux_dl_open
   Memcheck:Leak
   match-leak-kinds: reachable,definite,indirect,possible
   ...
   fun:_dl_open
}
{
   ld_linux_dl_map_object
   Memcheck:Leak
   match-leak-kinds: reachable,definite,indirect,possible
   ...
   fun:_dl_map_object
}

# ---------- GLFW ----------
{
   glfw_init_leak
   Memcheck:Leak
   match-leak-kinds: reachable,definite,indirect,possible
   ...
   fun:_glfwInitVulkan
}
{
   glfw_platform_init
   Memcheck:Leak
   match-leak-kinds: reachable,definite,indirect,possible
   ...
   fun:_glfwPlatformInit
}
{
   glfw_create_window
   Memcheck:Leak
   match-leak-kinds: reachable,definite,indirect,possible
   ...
   fun:glfwCreateWindow
}
{
   glfw_terminate
   Memcheck:Leak
   match-leak-kinds: reachable,definite,indirect,possible
   ...
   fun:glfwTerminate
}

# ---------- OpenGL / Mesa ----------
{
   mesa_loader_leak
   Memcheck:Leak
   match-leak-kinds: reachable,definite,indirect,possible
   ...
   fun:loader_open_driver
}
{
   mesa_dri_init
   Memcheck:Leak
   match-leak-kinds: reachable,definite,indirect,possible
   ...
   obj:*/dri/*.so
}
{
   mesa_glapi
   Memcheck:Leak
   match-leak-kinds: reachable,definite,indirect,possible
   ...
   fun:_glapi_add_dispatch
}
{
   libGL_init
   Memcheck:Leak
   match-leak-kinds: reachable,definite,indirect,possible
   ...
   obj:*/libGL.so*
}

