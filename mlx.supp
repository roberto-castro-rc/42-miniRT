}

# ---------- MLX42 internals ----------
{
   mlx42_init
   Memcheck:Leak
   match-leak-kinds: reachable,definite,indirect,possible
   ...
   fun:mlx_init
}
{
   mlx42_new_image
   Memcheck:Leak
   match-leak-kinds: reachable,definite,indirect,possible
